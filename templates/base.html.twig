<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block meta_description %}{{ company_name }} — Vente, présentation et maintenance de machines et équipements de fitness professionnels en Algérie.{% endblock %}">
    <title>{% block title %}{{ company_name }} — Équipements de Fitness Professionnels{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%230a0e10%22/><text y=%2270%22 x=%2212%22 font-size=%2260%22 fill=%22%2317c9c0%22>V</text></svg>">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('assets/css/style.css') }}" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark navbar-viefit fixed-top py-3">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('front_home') }}">
            <span class="navbar-logo" role="img" aria-label="{{ company_name }}"></span>
            VIE<span>FIT</span>
        </a>
        <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <i class="bi bi-list fs-1"></i>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="mainNavbar">
            <ul class="navbar-nav align-items-lg-center gap-lg-1">
                {% set current_route = app.current_route %}
                <li class="nav-item">
                    <a class="nav-link {{ current_route == 'front_home' ? 'active' }}" href="{{ path('front_home') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ current_route starts with 'front_catalog' or current_route starts with 'front_product' ? 'active' }}" href="{{ path('front_catalog') }}">Catalogue</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ current_route == 'front_service' ? 'active' }}" href="{{ path('front_service') }}">Services</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ current_route == 'front_sav' ? 'active' }}" href="{{ path('front_sav') }}">SAV</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ current_route == 'front_contact' ? 'active' }}" href="{{ path('front_contact') }}">Contact</a>
                </li>
                <li class="nav-item ms-lg-3 mt-3 mt-lg-0">
                    <a class="btn btn-teal btn-sm px-3" href="{{ path('front_contact') }}">Demander un devis</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main>
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="container mt-5 pt-4">
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="footer-viefit pt-5 pb-4 mt-auto">
    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 mb-3" href="{{ path('front_home') }}">
                    <span class="navbar-logo" role="img" aria-label="{{ company_name }}"></span>
                    VIE<span class="text-teal">FIT</span>
                </a>
                <p class="mb-3">{{ company_tagline }}. Vente, présentation et maintenance de machines de fitness professionnelles pour salles de sport, hôtels et particuliers en Algérie.</p>
                <div class="footer-social">
                    <a href="{{ facebook_url }}" target="_blank" rel="noopener"><i class="bi bi-facebook"></i></a>
                    <a href="{{ instagram_url }}" target="_blank" rel="noopener"><i class="bi bi-instagram"></i></a>
                    <a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener"><i class="bi bi-whatsapp"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-6">
                <h5 class="mb-3">Navigation</h5>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a href="{{ path('front_home') }}">Accueil</a></li>
                    <li><a href="{{ path('front_catalog') }}">Catalogue</a></li>
                    <li><a href="{{ path('front_service') }}">Services</a></li>
                    <li><a href="{{ path('front_sav') }}">SAV</a></li>
                    <li><a href="{{ path('front_contact') }}">Contact</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-6">
                <h5 class="mb-3">Direction</h5>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><i class="bi bi-geo-alt text-teal me-2"></i>{{ company_address }}</li>
                    <li><i class="bi bi-telephone text-teal me-2"></i><a href="tel:+{{ whatsapp_number }}">{{ phone_number }}</a></li>
                    <li><i class="bi bi-envelope text-teal me-2"></i><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></li>
                    <li><i class="bi bi-clock text-teal me-2"></i>{{ opening_hours }}</li>
                </ul>
            </div>
            <div class="col-lg-3">
                <h5 class="mb-3">Service Technique</h5>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><i class="bi bi-telephone text-teal me-2"></i><a href="tel:+{{ technical_phone_intl }}">{{ technical_phone }}</a></li>
                    <li><i class="bi bi-envelope text-teal me-2"></i><a href="mailto:{{ technical_email }}">{{ technical_email }}</a></li>
                </ul>
            </div>
        </div>
        <hr class="border-secondary my-4">
        <div class="text-center small">
            &copy; {{ "now"|date("Y") }} {{ company_name }}. Tous droits réservés.
        </div>
    </div>
</footer>

<a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener" class="whatsapp-float" title="Contactez-nous sur WhatsApp">
    <i class="bi bi-whatsapp"></i>
</a>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('assets/js/main.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
