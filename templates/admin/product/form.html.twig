{% extends 'admin/base.html.twig' %}

{% block title %}{{ isNew ? 'Nouveau produit' : 'Modifier ' ~ product.name }}{% endblock %}
{% block page_title %}{{ isNew ? 'Nouveau produit' : 'Modifier le produit' }}{% endblock %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block body %}

<div class="bg-white rounded-viefit border p-4" style="max-width: 900px;">
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
        <div class="row g-3">
            <div class="col-md-8">
                {{ form_row(form.name) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.category) }}
            </div>
            <div class="col-12">
                {{ form_row(form.shortDescription) }}
            </div>
            <div class="col-12">
                {{ form_row(form.description) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.brand) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.reference) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.keyFeatures) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.technicalSpecs) }}
            </div>

            <div class="col-md-6">
                {% if not isNew and product.mainImage %}
                    <div class="mb-2">
                        <img src="{{ asset('uploads/products/' ~ product.mainImage) }}" alt="" style="width:100px;height:100px;object-fit:contain;background:#f4f6f6;border-radius:0.35rem;">
                    </div>
                {% endif %}
                {{ form_row(form.mainImageFile) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.galleryFiles) }}
            </div>

            {% if not isNew and product.images|length > 0 %}
                <div class="col-12">
                    <label class="form-label">Galerie actuelle</label>
                    <div class="d-flex flex-wrap gap-2">
                        {% for image in product.images %}
                            <div class="position-relative">
                                <img src="{{ asset('uploads/products/' ~ image.filename) }}" alt="" style="width:80px;height:80px;object-fit:contain;background:#f4f6f6;border-radius:0.35rem;border:1px solid #e8ecec;">
                                <form method="post" action="{{ path('admin_product_image_delete', {id: image.id}) }}" class="position-absolute top-0 end-0" onsubmit="return confirm('Supprimer cette image ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-image-' ~ image.id) }}">
                                    <button type="submit" class="btn btn-sm btn-danger p-0" style="width:22px;height:22px;line-height:1;">×</button>
                                </form>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="col-md-6">
                {{ form_row(form.isFeatured) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.isActive) }}
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-teal px-4">Enregistrer</button>
            <a href="{{ path('admin_product_index') }}" class="btn btn-outline-secondary">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>

{% endblock %}
