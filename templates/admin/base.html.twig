<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Administration{% endblock %} — {{ company_name }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="{{ asset('assets/css/style.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/admin.css') }}" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body class="admin-body">

<div class="admin-layout">
    <aside class="admin-sidebar">
        <a href="{{ path('admin_dashboard') }}" class="admin-sidebar-brand">
            <span class="brand-logo-lg" style="width:42px;height:42px;"></span>
            <span>VIC<span class="text-teal">FIT</span></span>
        </a>
        <nav class="admin-nav">
            <a href="{{ path('admin_dashboard') }}" class="admin-nav-link {{ app.current_route == 'admin_dashboard' ? 'active' }}">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="{{ path('admin_product_index') }}" class="admin-nav-link {{ app.current_route starts with 'admin_product' ? 'active' }}">
                <i class="bi bi-box-seam"></i> Produits
            </a>
            <a href="{{ path('admin_category_index') }}" class="admin-nav-link {{ app.current_route starts with 'admin_category' ? 'active' }}">
                <i class="bi bi-tags"></i> Catégories
            </a>
            <a href="{{ path('admin_service_index') }}" class="admin-nav-link {{ app.current_route starts with 'admin_service' ? 'active' }}">
                <i class="bi bi-tools"></i> Services
            </a>
            <a href="{{ path('admin_message_contact_index') }}" class="admin-nav-link {{ app.current_route starts with 'admin_message' ? 'active' }}">
                <i class="bi bi-envelope"></i> Messages
                {% set unreadCount = admin_unread_messages_count() %}
                {% if unreadCount > 0 %}<span class="badge bg-danger ms-auto">{{ unreadCount }}</span>{% endif %}
            </a>
        </nav>
        <div class="admin-sidebar-footer">
            <a href="{{ path('front_home') }}" class="admin-nav-link" target="_blank">
                <i class="bi bi-box-arrow-up-right"></i> Voir le site
            </a>
            <a href="{{ path('admin_logout') }}" class="admin-nav-link text-danger">
                <i class="bi bi-box-arrow-left"></i> Déconnexion
            </a>
        </div>
    </aside>

    <div class="admin-main">
        <header class="admin-topbar">
            <h1 class="h5 mb-0">{% block page_title %}Dashboard{% endblock %}</h1>
            <div class="d-flex align-items-center gap-2 text-secondary small">
                <i class="bi bi-person-circle fs-5"></i>
                {{ app.user ? app.user.userIdentifier : '' }}
            </div>
        </header>

        <main class="admin-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
