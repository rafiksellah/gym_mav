{% extends 'admin/base.html.twig' %}

{% block title %}SAV — {{ savRequest.firstName }} {{ savRequest.lastName }}{% endblock %}
{% block page_title %}Détail de la demande SAV{% endblock %}

{% block body %}

<div class="bg-white rounded-viefit border p-4" style="max-width: 700px;">
    <dl class="row mb-0">
        <dt class="col-sm-3">Nom</dt>
        <dd class="col-sm-9">{{ savRequest.firstName }} {{ savRequest.lastName }}</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9"><a href="mailto:{{ savRequest.email }}">{{ savRequest.email }}</a></dd>

        <dt class="col-sm-3">Téléphone</dt>
        <dd class="col-sm-9">{{ savRequest.phone }}</dd>

        <dt class="col-sm-3">Produit concerné</dt>
        <dd class="col-sm-9">
            {% if savRequest.product %}
                <a href="{{ path('admin_product_edit', {id: savRequest.product.id}) }}">{{ savRequest.product.name }}</a>
            {% else %}
                —
            {% endif %}
        </dd>

        <dt class="col-sm-3">Sujet</dt>
        <dd class="col-sm-9">{{ savRequest.subject }}</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">{{ savRequest.createdAt|date('d/m/Y H:i') }}</dd>

        <dt class="col-sm-3">Message</dt>
        <dd class="col-sm-9" style="white-space: pre-line;">{{ savRequest.message }}</dd>
    </dl>

    <div class="mt-4 d-flex gap-2">
        <a href="{{ path('admin_message_sav_index') }}" class="btn btn-outline-secondary">Retour</a>
        <form method="post" action="{{ path('admin_message_sav_delete', {id: savRequest.id}) }}" onsubmit="return confirm('Supprimer cette demande ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-message-' ~ savRequest.id) }}">
            <button type="submit" class="btn btn-outline-danger">Supprimer</button>
        </form>
    </div>
</div>

{% endblock %}
