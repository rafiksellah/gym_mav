{% extends 'admin/base.html.twig' %}

{% block title %}Clients{% endblock %}
{% block page_title %}Clients{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
    <form method="get" class="d-flex gap-2 flex-grow-1" style="max-width:420px;">
        <input type="search" name="q" value="{{ search }}" class="form-control" placeholder="Rechercher un client (nom, NIF, NIS, Article)...">
        <button type="submit" class="btn btn-outline-secondary flex-shrink-0"><i class="bi bi-search"></i></button>
    </form>
    <a href="{{ path('admin_client_new') }}" class="btn btn-teal">
        <i class="bi bi-plus-lg me-1"></i> Nouveau client
    </a>
</div>

<div class="table-responsive bg-white rounded-viefit border">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Nom du client</th>
                <th>NIF</th>
                <th>Article</th>
                <th>NIS</th>
                <th class="text-end">Factures</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for client in clients %}
                <tr>
                    <td class="fw-semibold">{{ client.name }}</td>
                    <td class="small text-secondary">{{ client.nif ?: '—' }}</td>
                    <td class="small text-secondary">{{ client.ai ?: '—' }}</td>
                    <td class="small text-secondary">{{ client.nis ?: '—' }}</td>
                    <td class="text-end">{{ client.invoices|length }}</td>
                    <td class="text-end">
                        <a href="{{ path('admin_client_edit', {id: client.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('admin_client_delete', {id: client.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce client ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-client-' ~ client.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-secondary py-4">Aucun client pour le moment.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
