<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Facture {{ invoice.number }}</title>
<style>
    {% if scriptFontPath %}
    @font-face {
        font-family: 'InvoiceScript';
        src: url('{{ scriptFontPath }}');
        font-weight: normal;
        font-style: normal;
    }
    {% endif %}

    @page { margin: 0 12mm 0 12mm; }

    * { box-sizing: border-box; }

    body {
        font-family: 'DejaVu Sans', sans-serif;
        color: #1c2733;
        font-size: 10.5px;
        margin: 0;
        padding: 0 0 26mm 0;
    }

    .navy { color: #0A396B; }
    .red { color: #E81030; }

    table { border-collapse: collapse; width: 100%; }

    .icon { vertical-align: middle; }

    /* ---------- Watermark ---------- */
    .watermark {
        position: fixed;
        bottom: 28mm;
        left: -20mm;
        width: 250px;
        opacity: 0.06;
        z-index: -10;
    }

    .footer-ribbon {
        position: fixed;
        bottom: 14mm;
        right: -12mm;
        width: 150px;
        z-index: -5;
    }

    /* ---------- Header ---------- */
    .header-wrap {
        position: relative;
        height: 95mm;
        margin: 0 -12mm 10px -12mm;
        overflow: hidden;
    }

    .header-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
    }

    .header-table { table-layout: fixed; height: 100%; }
    .header-table td { vertical-align: top; }

    .brand-cell { width: 43%; padding: 6mm 4px 0 12mm; }
    .brand-logo { margin-bottom: 4mm; }
    .brand-logo img { width: 46mm; }

    .company-name {
        font-family: 'DejaVu Serif', serif;
        font-size: 26px;
        font-weight: bold;
        color: #0A396B;
        letter-spacing: 0.5px;
        margin: 0 0 3px;
        white-space: nowrap;
    }

    .company-tagline {
        font-size: 10.5px;
        font-weight: bold;
        color: #0A396B;
        margin-bottom: 2px;
        line-height: 1.5;
        white-space: nowrap;
    }

    .company-tagline .tagline-sub {
        font-weight: bold;
        text-transform: none;
    }

    .company-tagline .red { color: #E81030; }

    .company-script {
        font-family: {% if scriptFontPath %}'InvoiceScript', {% endif %}'DejaVu Sans', cursive;
        font-size: 15px;
        font-style: italic;
        color: #2f6fb0;
        margin-top: 4px;
        white-space: normal;
    }

    .contact-cell {
        width: 57%;
        padding: 30mm 12mm 0 5mm;
        color: #ffffff;
    }

    .contact-row {
        font-size: 9px;
        padding: 2.5px 0;
        color: #ffffff;
        line-height: 1.35;
    }

    .contact-row .icon-wrap {
        display: inline-block;
        width: 15px;
        text-align: center;
    }

    .legal-block {
        font-size: 8px;
        color: #ffffff;
        line-height: 1.55;
        margin-top: 6px;
        padding-top: 6px;
        border-top: 1px solid rgba(255,255,255,0.3);
    }

    .legal-block b { font-weight: bold; }

    /* ---------- Client / Facture / Date band ---------- */
    .meta-table { margin-top: 4px; }

    .meta-table td {
        vertical-align: top;
        border-top: 2px solid #0A396B;
        border-bottom: 2px solid #0A396B;
        padding: 10px 12px;
    }

    .client-cell { width: 42%; border-right: 1px solid #d7dce2; }

    .client-label {
        font-size: 10px;
        font-weight: bold;
        color: #0A396B;
        text-transform: uppercase;
        border-bottom: 1px solid #c7ccd2;
        padding-bottom: 4px;
        margin-bottom: 5px;
    }

    .client-label .icon-wrap { margin-right: 6px; display: inline-block; width: 12px; }

    .client-name { font-size: 11px; font-weight: bold; margin-bottom: 4px; }
    .client-line { font-size: 9.5px; color: #444; margin-bottom: 2px; }
    .client-line .icon-wrap { display: inline-block; width: 12px; margin-right: 2px; }

    .facture-cell { width: 34%; text-align: center; border-right: 1px solid #d7dce2; }

    .facture-title {
        font-size: 27px;
        font-weight: bold;
        color: #0A396B;
        letter-spacing: 2px;
        margin-bottom: 7px;
    }

    .facture-number {
        display: inline-block;
        background-color: #0A396B;
        color: #fff;
        font-weight: bold;
        font-size: 11px;
        padding: 5px 16px;
        border-radius: 4px;
    }

    .date-cell { width: 24%; text-align: right; }
    .date-label { font-size: 8.5px; color: #0A396B; text-transform: uppercase; margin-bottom: 3px; }
    .date-label .icon-wrap { margin-right: 4px; display: inline-block; width: 11px; }
    .date-value { font-size: 12px; font-weight: bold; color: #0A396B; }

    /* ---------- Lines table ---------- */
    .lines-table { margin-top: 16px; }

    .lines-table thead th {
        background-color: #0A396B;
        color: #fff;
        font-size: 9.5px;
        text-transform: uppercase;
        padding: 8px;
        text-align: left;
    }

    .lines-table thead th:first-child { border-radius: 6px 0 0 0; }
    .lines-table thead th:last-child { border-radius: 0 6px 0 0; }

    .lines-table thead th.num { text-align: center; width: 6%; }
    .lines-table thead th.qty { text-align: center; width: 9%; }
    .lines-table thead th.pu { text-align: right; width: 17%; }
    .lines-table thead th.montant { text-align: right; width: 18%; }

    .lines-table tbody td {
        padding: 8px;
        font-size: 9.8px;
        border-bottom: 1px solid #e7eaee;
    }

    .lines-table tbody tr.odd { background-color: #ffffff; }
    .lines-table tbody tr.even { background-color: #eef2f7; }

    .lines-table td.num { text-align: center; color: #55606b; }
    .lines-table td.qty { text-align: center; }
    .lines-table td.pu, .lines-table td.montant { text-align: right; }
    .lines-table td.montant { font-weight: bold; }

    /* ---------- Totals ---------- */
    .totals-wrap { width: 100%; margin-top: 6px; }
    .totals-table { width: 48%; float: right; border-radius: 6px; overflow: hidden; }

    .totals-table td {
        padding: 7px 12px;
        font-size: 10px;
        background-color: #eef2f9;
        border-bottom: 1px solid #e2e6eb;
    }

    .totals-table td.label { color: #33404c; font-weight: bold; }
    .totals-table td.value { text-align: right; font-weight: bold; background-color: #ffffff; }

    .totals-table tr.grand-total td {
        background-color: #0A396B;
        color: #fff;
        font-size: 13px;
        font-weight: bold;
        border-bottom: none;
    }

    .amount-words {
        clear: both;
        padding-top: 28px;
    }

    .amount-words .label { font-size: 9.5px; color: #333; }
    .amount-words .value {
        font-size: 15px;
        font-weight: bold;
        font-style: italic;
        color: #0A396B;
        margin-top: 4px;
    }

    .payment-block {
        margin-top: 18px;
        font-size: 9px;
        color: #55606b;
    }

    .payment-block strong { color: #0A396B; }

    /* ---------- Footer ---------- */
    .invoice-footer {
        position: fixed;
        bottom: 0;
        left: -12mm;
        right: -12mm;
        background-color: #0A396B;
        color: #fff;
        font-size: 8.6px;
        padding: 8px 12mm;
    }

    .invoice-footer table td {
        text-align: center;
        color: #fff;
        border-left: 1px solid rgba(255,255,255,0.3);
        padding: 2px 4px;
    }
    .invoice-footer table td:first-child { border-left: none; }
    .invoice-footer .icon-wrap { margin-right: 5px; display: inline-block; width: 11px; }
</style>
</head>
<body>

{% if logoDataUri %}
    <img src="{{ logoDataUri }}" class="watermark" alt="">
{% endif %}
{% if footerRibbonDataUri %}
    <img src="{{ footerRibbonDataUri }}" class="footer-ribbon" alt="">
{% endif %}

<div class="header-wrap">
    {% if headerPanelDataUri %}<img src="{{ headerPanelDataUri }}" class="header-bg" alt="">{% endif %}

    <table class="header-table">
        <tr>
            <td class="brand-cell">
                {% if logoDataUri %}
                    <div class="brand-logo"><img src="{{ logoDataUri }}" alt="Logo"></div>
                {% endif %}
                <div class="company-name">{{ settings.name }}</div>
                {% if settings.tagline %}
                    {% set taglineParts = settings.tagline|split('|') %}
                    {% if taglineParts|length > 1 %}
                        {% set afterPipe = taglineParts[1]|trim|split(' ', 2) %}
                        <div class="company-tagline">{{ taglineParts[0]|trim|upper }} <span class="red">| {{ afterPipe[0]|upper }}</span>{% if afterPipe[1] is defined %}<br><span class="tagline-sub">{{ afterPipe[1] }}</span>{% endif %}</div>
                    {% else %}
                        <div class="company-tagline">{{ settings.tagline }}</div>
                    {% endif %}
                {% endif %}
                {% if settings.slogan %}
                    <div class="company-script">{{ settings.slogan }}</div>
                {% endif %}
            </td>
            <td class="contact-cell">
                {% if settings.address %}<div class="contact-row"><span class="icon-wrap"><img src="{{ icon.pin_white }}" width="10" class="icon"></span>{{ settings.address }}</div>{% endif %}
                {% if settings.phone %}<div class="contact-row"><span class="icon-wrap"><img src="{{ icon.phone_white }}" width="10" class="icon"></span>&nbsp;Tél. : {{ settings.phone }}</div>{% endif %}
                {% if settings.email %}<div class="contact-row"><span class="icon-wrap"><img src="{{ icon.envelope_white }}" width="10" class="icon"></span>&nbsp;Email : {{ settings.email }}</div>{% endif %}
                {% if settings.website %}<div class="contact-row"><span class="icon-wrap"><img src="{{ icon.globe_white }}" width="10" class="icon"></span>&nbsp;{{ settings.website }}</div>{% endif %}

                <div class="legal-block">
                    {% if settings.rc or settings.ai %}<b>RC</b> : {{ settings.rc }}{% if settings.ai %} &nbsp;|&nbsp; <b>AI</b> : {{ settings.ai }}{% endif %}<br>{% endif %}
                    {% if settings.nif or settings.nis %}<b>NIF N°</b> : {{ settings.nif }}{% if settings.nis %} &nbsp;|&nbsp; <b>NIS N°</b> : {{ settings.nis }}{% endif %}<br>{% endif %}
                    {% if settings.capitalSocial %}<b>Capital social</b> : {{ settings.capitalSocial }}<br>{% endif %}
                    {% if settings.rib %}<b>RIB</b> : {{ settings.rib }}<br>{% endif %}
                    {% if settings.bankInfo %}{{ settings.bankInfo }}{% endif %}
                </div>
            </td>
        </tr>
    </table>
</div>

<table class="meta-table">
    <tr>
        <td class="client-cell">
            <div class="client-label"><span class="icon-wrap"><img src="{{ icon.building_navy }}" width="10" class="icon"></span>Client</div>
            <div class="client-name">{{ invoice.client.fullName }}</div>
            {% if invoice.client.nif %}<div class="client-line">NIF : {{ invoice.client.nif }}</div>{% endif %}
            {% if invoice.client.ai %}<div class="client-line">Article : {{ invoice.client.ai }}</div>{% endif %}
            {% if invoice.client.nis %}<div class="client-line">NIS : {{ invoice.client.nis }}</div>{% endif %}
            <div class="client-line"><span class="icon-wrap"><img src="{{ icon.envelope_navy }}" width="8" class="icon"></span>&nbsp;—</div>
            <div class="client-line"><span class="icon-wrap"><img src="{{ icon.phone_navy }}" width="8" class="icon"></span>&nbsp;—</div>
        </td>
        <td class="facture-cell">
            <div class="facture-title">FACTURE</div>
            <div class="facture-number">N° {{ invoice.number }}</div>
        </td>
        <td class="date-cell">
            <div class="date-label"><span class="icon-wrap"><img src="{{ icon.calendar_navy }}" width="9" class="icon"></span>Date d'émission</div>
            <div class="date-value">{{ invoice.invoiceDate ? invoice.invoiceDate|date('d/m/Y') : '' }}</div>
        </td>
    </tr>
</table>

<table class="lines-table">
    <thead>
        <tr>
            <th class="num">N°</th>
            <th>Désignation</th>
            <th class="qty">Qté</th>
            <th class="pu">P.U ({{ invoice.currency }})</th>
            <th class="montant">Montant ({{ invoice.currency }})</th>
        </tr>
    </thead>
    <tbody>
        {% for line in invoice.lines %}
            <tr class="{{ loop.index is odd ? 'odd' : 'even' }}">
                <td class="num">{{ loop.index }}</td>
                <td>{{ line.description }}</td>
                <td class="qty">{{ line.quantity|invoice_qty }}</td>
                <td class="pu">{{ line.unitPriceHt|invoice_money }}</td>
                <td class="montant">{{ line.lineTotal|invoice_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<div class="totals-wrap">
    <table class="totals-table">
        <tr>
            <td class="label">TOTAL / H.T</td>
            <td class="value">{{ invoice.totalHt|invoice_money }}</td>
        </tr>
        <tr>
            <td class="label">T.V.A / 19 %</td>
            <td class="value">{{ invoice.totalVat|invoice_money }}</td>
        </tr>
        <tr class="grand-total">
            <td class="label">TOTAL / T.T.C</td>
            <td class="value">{{ invoice.totalTtc|invoice_money }}</td>
        </tr>
    </table>
</div>

<div class="amount-words">
    <div class="label">Arrêtée la somme de :</div>
    <div class="value">{{ amountInWords }} en TTC.</div>
</div>

{% if settings.paymentTerms or settings.legalMentions or invoice.notes %}
<div class="payment-block">
    {% if settings.paymentTerms %}<div>{{ settings.paymentTerms }}</div>{% endif %}
    {% if settings.legalMentions %}<div style="margin-top:6px;font-style:italic;">{{ settings.legalMentions }}</div>{% endif %}
    {% if invoice.notes %}<div style="margin-top:6px;">{{ invoice.notes }}</div>{% endif %}
</div>
{% endif %}

<div class="invoice-footer">
    <table>
        <tr>
            {% if settings.phone %}<td><span class="icon-wrap"><img src="{{ icon.phone_white }}" width="9" class="icon"></span>{{ settings.phone }}</td>{% endif %}
            {% if settings.email %}<td><span class="icon-wrap"><img src="{{ icon.envelope_white }}" width="9" class="icon"></span>{{ settings.email }}</td>{% endif %}
            {% if settings.website %}<td><span class="icon-wrap"><img src="{{ icon.globe_white }}" width="9" class="icon"></span>{{ settings.website }}</td>{% endif %}
            <td><span class="icon-wrap"><img src="{{ icon.pin_white }}" width="9" class="icon"></span>Oran - Algérie</td>
        </tr>
    </table>
</div>

</body>
</html>
