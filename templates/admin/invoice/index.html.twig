{% extends 'admin/base.html.twig' %}

{% block title %}Factures{% endblock %}
{% block page_title %}Factures{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
    <form method="get" class="d-flex gap-2">
        <input type="search" name="q" value="{{ search }}" class="form-control" placeholder="Rechercher (N°, client, référence)..." style="min-width:320px;">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
    </form>
    <a href="{{ path('admin_invoice_new') }}" class="btn btn-teal">
        <i class="bi bi-plus-lg me-1"></i> Nouvelle facture
    </a>
</div>

<div class="table-responsive bg-white rounded-viefit border">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>N°</th>
                <th>Date</th>
                <th>Client</th>
                <th>Référence</th>
                <th class="text-end">Total TTC</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for invoice in invoices %}
                <tr>
                    <td class="fw-semibold">{{ invoice.number }}</td>
                    <td>{{ invoice.invoiceDate ? invoice.invoiceDate|date('d/m/Y') : '' }}</td>
                    <td>{{ invoice.client.fullName }}</td>
                    <td class="text-secondary small">{{ invoice.reference }}</td>
                    <td class="text-end fw-semibold">{{ invoice.totalTtc|number_format(2, ',', ' ') }} {{ invoice.currency }}</td>
                    <td class="text-end">
                        <a href="{{ path('admin_invoice_show', {id: invoice.id}) }}" class="btn btn-sm btn-outline-secondary" title="Aperçu">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a href="{{ path('admin_invoice_edit', {id: invoice.id}) }}" class="btn btn-sm btn-outline-secondary" title="Modifier">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <a href="{{ path('admin_invoice_pdf', {id: invoice.id}) }}" class="btn btn-sm btn-outline-secondary" title="PDF">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </a>
                        <form method="post" action="{{ path('admin_invoice_delete', {id: invoice.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette facture ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-invoice-' ~ invoice.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="text-center text-secondary py-4">Aucune facture pour le moment.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
