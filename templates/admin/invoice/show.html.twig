{% extends 'admin/base.html.twig' %}

{% block title %}Facture {{ invoice.number }}{% endblock %}
{% block page_title %}Facture {{ invoice.number }}{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4 gap-2 flex-wrap">
    <a href="{{ path('admin_invoice_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Retour
    </a>
    <div class="d-flex gap-2">
        <a href="{{ path('admin_invoice_edit', {id: invoice.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-pencil me-1"></i> Modifier
        </a>
        <a href="{{ path('admin_invoice_pdf', {id: invoice.id, mode: 'inline'}) }}" target="_blank" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
        </a>
        <a href="{{ path('admin_invoice_excel', {id: invoice.id}) }}" class="btn btn-outline-secondary">
            <i class="bi bi-file-earmark-excel me-1"></i> Excel
        </a>
        <form method="post" action="{{ path('admin_invoice_delete', {id: invoice.id}) }}" onsubmit="return confirm('Supprimer cette facture ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete-invoice-' ~ invoice.id) }}">
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-trash me-1"></i> Supprimer
            </button>
        </form>
    </div>
</div>

<div class="bg-white rounded-viefit border p-4 mb-4">
    <div class="row g-4">
        <div class="col-md-6">
            <div class="small text-secondary text-uppercase mb-1">Émetteur</div>
            <div class="fw-semibold">{{ settings.name }}</div>
            {% if settings.address %}<div class="small text-secondary">{{ settings.address }}</div>{% endif %}
        </div>
        <div class="col-md-6">
            <div class="small text-secondary text-uppercase mb-1">Client</div>
            <div class="fw-semibold">{{ invoice.client.fullName }}</div>
            {% if invoice.client.nif %}<div class="small text-secondary">NIF : {{ invoice.client.nif }}</div>{% endif %}
            {% if invoice.client.ai %}<div class="small text-secondary">Article : {{ invoice.client.ai }}</div>{% endif %}
            {% if invoice.client.nis %}<div class="small text-secondary">NIS : {{ invoice.client.nis }}</div>{% endif %}
        </div>
    </div>

    <hr class="my-4">

    <div class="row g-3">
        <div class="col-md-3">
            <div class="small text-secondary">N° de facture</div>
            <div class="fw-semibold">{{ invoice.number }}</div>
        </div>
        <div class="col-md-3">
            <div class="small text-secondary">Date d'émission</div>
            <div class="fw-semibold">{{ invoice.invoiceDate ? invoice.invoiceDate|date('d/m/Y') : '—' }}</div>
        </div>
    </div>
</div>

<div class="table-responsive bg-white rounded-viefit border mb-4">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Désignation</th>
                <th class="text-end">Qté</th>
                <th class="text-end">P.U HT</th>
                <th class="text-end">Montant</th>
            </tr>
        </thead>
        <tbody>
            {% for line in invoice.lines %}
                <tr>
                    <td>{{ line.description }}</td>
                    <td class="text-end">{{ line.quantity|invoice_qty }}{% if line.unit %} {{ line.unit }}{% endif %}</td>
                    <td class="text-end">{{ line.unitPriceHt|invoice_money }}</td>
                    <td class="text-end fw-semibold">{{ line.lineTotal|invoice_money }} {{ invoice.currency }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-secondary py-4">Aucune ligne sur cette facture.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="row justify-content-end mb-4">
    <div class="col-md-5">
        <div class="bg-white rounded-viefit border p-4">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary">Total HT</span>
                <span>{{ invoice.totalHt|invoice_money }} {{ invoice.currency }}</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary">TVA (19%)</span>
                <span>{{ invoice.totalVat|invoice_money }} {{ invoice.currency }}</span>
            </div>
            <hr>
            <div class="d-flex justify-content-between fs-5 fw-bold">
                <span>Total TTC</span>
                <span>{{ invoice.totalTtc|invoice_money }} {{ invoice.currency }}</span>
            </div>
        </div>
    </div>
</div>

{% if invoice.notes %}
    <div class="bg-white rounded-viefit border p-4">
        <div class="small text-secondary text-uppercase mb-2">Notes</div>
        <div style="white-space: pre-line;">{{ invoice.notes }}</div>
    </div>
{% endif %}

{% endblock %}
