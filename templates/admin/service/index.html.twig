{% extends 'admin/base.html.twig' %}

{% block title %}Services{% endblock %}
{% block page_title %}Services{% endblock %}

{% block body %}

<div class="d-flex justify-content-between align-items-center mb-4">
    <p class="text-secondary mb-0">{{ services|length }} service{{ services|length > 1 ? 's' : '' }}</p>
    <a href="{{ path('admin_service_new') }}" class="btn btn-teal">
        <i class="bi bi-plus-lg me-1"></i> Nouveau service
    </a>
</div>

<div class="table-responsive bg-white rounded-viefit border">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Icône</th>
                <th>Titre</th>
                <th>Ordre</th>
                <th>Statut</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for service in services %}
                <tr>
                    <td><i class="bi {{ service.icon }} fs-4 text-teal"></i></td>
                    <td class="fw-semibold">{{ service.title }}</td>
                    <td>{{ service.position }}</td>
                    <td>
                        <form method="post" action="{{ path('admin_service_toggle_active', {id: service.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-service-' ~ service.id) }}">
                            <button type="submit" class="btn btn-sm {{ service.isActive ? 'btn-success' : 'btn-outline-secondary' }}">
                                {{ service.isActive ? 'Actif' : 'Inactif' }}
                            </button>
                        </form>
                    </td>
                    <td class="text-end">
                        <a href="{{ path('admin_service_edit', {id: service.id}) }}" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form method="post" action="{{ path('admin_service_delete', {id: service.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce service ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-service-' ~ service.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-center text-secondary py-4">Aucun service pour le moment.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
